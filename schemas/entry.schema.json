{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Coding Hub — MCP entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "description",
    "tags",
    "author",
    "repo",
    "install"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "category": {
      "enum": [
        "core",
        "data",
        "web",
        "devops",
        "ai"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^https://"
    },
    "featured": {
      "type": "boolean"
    },
    "install": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "claude": {
          "type": "object",
          "required": [
            "mcpServers"
          ]
        },
        "cursor": {
          "type": "object",
          "required": [
            "mcpServers"
          ]
        },
        "vscode": {
          "type": "object",
          "required": [
            "servers"
          ]
        },
        "windsurf": {
          "type": "object",
          "required": [
            "mcpServers"
          ]
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "description"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
